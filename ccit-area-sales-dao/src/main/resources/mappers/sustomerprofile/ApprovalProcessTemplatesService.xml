<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccit.area.sales.dao.mapper.customerprofile.CustomerGradeMapper">

    <select id="selectPageList" resultType="com.ccit.area.sales.dao.vo.customer.TCustomerGradeVO">
        SELECT
        id,
        customer_name,
        customer_grade,
        annual,
        created_at,
        created_by
        FROM t_customer_grade
        <where>
            is_deleted = #{param.is_deleted}
            <if test="param.customerName != null and param.customerName != ''">
                AND customer_name LIKE CONCAT('%', #{param.customerName}, '%')
            </if>
            <if test="param.customerGrade != null and param.customerGrade != ''">
                AND customer_grade LIKE CONCAT('%', #{param.customerGrade}, '%')
            </if>
            <if test="param.annual != null and param.annual != ''">
                AND annual LIKE CONCAT('%', #{param.annual}, '%')
            </if>
            <if test="param.createdAt != null and param.createdAt != ''">
                AND created_at LIKE CONCAT('%',#{param.createdAt} , '%')
            </if>
            <if test="param.createdBy != null and param.createdBy != ''">
                AND created_by LIKE CONCAT('%', #{param.createdBy}, '%')
            </if>
        </where>
    </select>
</mapper>

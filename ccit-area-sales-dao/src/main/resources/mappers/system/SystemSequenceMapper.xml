<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccit.area.sales.dao.mapper.system.SystemSequenceMapper">

    <select id="selectOrg" resultType="com.ccit.area.sales.dao.vo.system.SystemGroupOrgNameVO">
        select
            t_system_org.id AS orgId,
            t_system_org.org_name AS orgName
        from
            t_system_org
        where
            t_system_org.org_no = #{orgNo}
    </select>

    <select id="selectValue" resultType="java.lang.Long">
        select
            t_system_sequence.value
        from
            t_system_sequence
        where
            t_system_sequence.code = #{code}
    </select>
</mapper>

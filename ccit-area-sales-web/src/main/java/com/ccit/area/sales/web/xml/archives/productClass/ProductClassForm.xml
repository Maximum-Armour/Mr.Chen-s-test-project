<?xml version="1.0" encoding="UTF-8"?>
<page id="productClassForm" version="1.0">
	<window id="productClassFormWin" title="产品分类" autoScroll="true" width="700" height="550" resize="false" maximizable="true">
		<formpanel id="productClassForm" columns="1" method="/webapi/archives/productClass/get?id=#{id}">
			<formwidget xtype="filesetBegin" title="基本信息" columns="2"/>
			<formwidget fieldLabel="主键ID" fieldProp="id" xtype="textfield" hidden="true" allowBlank="true" />
			<formwidget fieldLabel="产品分类编码" fieldProp="productClassNo" xtype="textfield" />
			<formwidget fieldLabel="产品分类名称" fieldProp="productClassName" xtype="textfield" />
			<formwidget fieldLabel="产品分类排序" fieldProp="productClassOrders" xtype="numberfield" />
			<formwidget fieldLabel="父分类ID" fieldProp="parentId" xtype="textfield" hidden="true" allowBlank="true" />
			<formwidget fieldLabel="父分类" fieldProp="parentName" xtype="treecombo" url="/webapi/archives/productClass/tree/list" 
				text="productClassName" callback="setParent" expands="getParent" firstRoot="{text: '根目录', id: 0, leaf: true}" />
			<formwidget fieldLabel="主副产品" fieldProp="mainOrByproduct" xtype="combo" key="zfproduct" />
			<formwidget fieldLabel="是否危化品" fieldProp="isWhp" xtype="combo" key="whp" />
			<formwidget fieldLabel="状态" fieldProp="status" xtype="combo" key="status" value="SY" />
			<formwidget xtype="filesetEnd" />
			<formwidget xtype="filesetBegin" title="制单用户信息" columns="2"/>
			<formwidget fieldLabel="制单人" fieldProp="createByName" xtype="displayfield" />
			<formwidget fieldLabel="制单时间" fieldProp="gmtCreate" xtype="displayfield" />
			<formwidget fieldLabel="单位名称" fieldProp="orgName" xtype="displayfield" />
			<formwidget fieldLabel="部门名称" fieldProp="deptName" xtype="displayfield" />
			<formwidget fieldLabel="最后修改人" fieldProp="updateByName" xtype="displayfield" />
			<formwidget fieldLabel="最后修改时间" fieldProp="gmtModified" xtype="displayfield" />
			<formwidget xtype="filesetEnd" />
		</formpanel>
		<button id="save" text="保存" iconCls="saveButton" handler="CrrHandler" />
	</window>
	<script id="script"><![CDATA[
		// 触发事件
		function CrrHandler(t) {
			// 保存&更新事件
			if (t.id == "save") {
				if (Ext.getCmp('productClassForm').getForm().isValidCux()) {
					var data = Ext.getCmp("productClassForm").getForm().getValues();
					var url = "/webapi/archives/productClass/add";
					if (data.id != null && data.id != "") {
						url = "/webapi/archives/productClass/edit";
					}
					post(url, data, function(res) {
						Ext.MessageBox.alert("提示", res.msg);
						Ext.getCmp('productClassTreeList').getStore().load({params: {parentId: 'root'}});
						Ext.getCmp('productClassFormWin').close();
					});
				}
			}
		}
		// 父分类赋值
		function setParent(data) {
			Ext.getCmp("productClassForm").getForm().findField("parentId").setValue(data.parentId);
		}
		// 获取父分类值
		function getParent() {
			var form = Ext.getCmp("productClassForm").getForm();
			var data = {
				id: form.findField("id").getValue(),
				parentId: form.findField("parentId").getValue()
			}
			return data;
		}
	]]></script>
</page>
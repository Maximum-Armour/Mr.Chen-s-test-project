<?xml version="1.0" encoding="UTF-8"?>
<page id="chooseDepot" version="1.0">
	<window id="depotWin" title="选择仓库档案" autoScroll="true" width="1100" height="600" resize="false" maximizable="true">
		<gridpanel id="depot" url="/webapi/archives/depot/page/list" mode="single">
			<column label="仓库编码" prop="depotNo" xtype="textfield" />
			<column label="仓库名称" prop="depotName" xtype="textfield" />
			<column label="是否港口" prop="isPort" xtype="combo" comboKey="port" />
			<column label="是否中转库" prop="isTransit" xtype="combo" comboKey="transit" />
			<column label="状态" prop="status" xtype="combo" comboKey="status" />
			<column label="管理员" prop="manager" xtype="textfield" />
			<column label="管理员联系电话" prop="managerTelephone" xtype="textfield" />
		</gridpanel>
		<button id="depotVerify" text="确定" iconCls="commitButton" handler="CrrHandler" callback="confirm" />
	</window>
	<script id="script"><![CDATA[
		// 触发事件
		function CrrHandler(t) {
			// 确定事件
			if (t.id == "depotVerify") {
				var records = Ext.getCmp("depot").getSelectionModel().getSelection();
				if (records.length != 1) {
					Ext.MessageBox.alert("提示", "请选择一行进行确认!");
					return false;
				}
				eval(t.callback + "(records[0].data)");
				depotWin.close();
			}
		}
	]]></script>
</page>
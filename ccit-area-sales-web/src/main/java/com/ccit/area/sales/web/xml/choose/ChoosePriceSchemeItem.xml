<?xml version="1.0" encoding="UTF-8"?>
<page id="choosePriceSchemeItem" version="1.0">
	<window id="priceSchemeItemWin" title="选择定价方案明细" autoScroll="true" width="1000" height="600" resize="false" maximizable="true">
		<gridpanel id="priceSchemeItem" url="/webapi/marketing/priceScheme/item/page/list">
			<column label="方案编码" prop="schemeNo" xtype="textfield" />
			<column label="方案明细编码" prop="schemeItemNo" xtype="textfield" width="170" />
			<column label="区域编码" prop="areaNo" xtype="textfield" hidden="true" />
			<column label="区域名称" prop="areaName" xtype="textfield" />
			<column label="提货地编码" prop="deliveryPlaceNo" xtype="textfield" hidden="true" />
			<column label="提货地名称" prop="deliveryPlaceName" xtype="textfield" />
			<column label="提货地分类编码" prop="deliveryPlaceClassNo" xtype="textfield" hidden="true" />
			<column label="提货地分类名称" prop="deliveryPlaceClassName" xtype="textfield" />
			<column label="配送方式" prop="distributionWay" xtype="combo" comboKey="psfs" />
			<column label="运输方式" prop="transportWay" xtype="combo" comboKey="ysfs" />
			<column label="支付方式" prop="payWay" xtype="combo" comboKey="zhlx" />
			<column label="币种" prop="currency" xtype="combo" comboKey="currency" />
			<column label="单位" prop="unit" xtype="combo" comboKey="unit" />
		</gridpanel>
		<button id="priceSchemeItemVerify" text="确定" iconCls="commitButton" handler="CrrHandler" callback="confirm" />
	</window>
	<script id="script"><![CDATA[
		// 触发事件
		function CrrHandler(t) {
			// 确定事件
			if (t.id == "priceSchemeItemVerify") {
				var records = Ext.getCmp("priceSchemeItem").getSelectionModel().getSelection();
				if (records.length < 1) {
					Ext.MessageBox.alert("提示", "请选择一行进行确认!");
					return false;
				}
				eval(t.callback + "(records)");
				priceSchemeItemWin.close();
			}
		}
	]]></script>
</page>
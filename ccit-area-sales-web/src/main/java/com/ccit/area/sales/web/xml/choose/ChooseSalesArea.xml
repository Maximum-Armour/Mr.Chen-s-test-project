<?xml version="1.0" encoding="UTF-8"?>
<page id="chooseSalesArea" version="1.0">
	<window id="salesAreaWin" title="选择销售区域" autoScroll="true" width="800" height="600" resize="false" maximizable="true">
		<gridpanel id="salesArea" url="/webapi/archives/salesArea/page/list" mode="single">
			<column label="区域编码" prop="areaNo" xtype="textfield" />
			<column label="区域名称" prop="areaName" xtype="textfield" />
			<column label="产品分类编码" prop="productClassNo" xtype="textfield" hidden="true" />
			<column label="产品分类名称" prop="productClassName" xtype="textfield" />
			<column label="贸易类型" prop="tradeType" xtype="combo" comboKey="tradeType" />
			<column label="状态" prop="status" xtype="combo" comboKey="status" />
			<column label="备注" prop="remark" xtype="textfield"  hidden="true" />
		</gridpanel>
		<button id="salesAreaVerify" text="确定" iconCls="commitButton" handler="CrrHandler" callback="confirm" />
	</window>
	<script id="script"><![CDATA[
		// 触发事件
		function CrrHandler(t) {
			// 确定事件
			if (t.id == "salesAreaVerify") {
				var records = Ext.getCmp("salesArea").getSelectionModel().getSelection();
				if (records.length != 1) {
					Ext.MessageBox.alert("提示", "请选择一行进行确认!");
					return false;
				}
				eval(t.callback + "(records[0].data)");
				salesAreaWin.close();
			}
		}
	]]></script>
</page>
<?xml version="1.0" encoding="UTF-8"?>
<page id="listedForm" version="1.0">
	<window id="listedFormWin" title="挂牌" autoScroll="true">
		<formpanel id="listedForm" columns="1" method="/webapi/marketing/listed/get?id=#{id}">
			<formwidget xtype="filesetBegin" title="基本信息" columns="4"/>
			<formwidget fieldLabel="主键ID" fieldProp="id" xtype="textfield" hidden="true" allowBlank="true" />
			<formwidget fieldLabel="挂牌编码" fieldProp="listedNo" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="挂牌模式" fieldProp="listedMode" xtype="combo" key="listedMode" />
			<formwidget fieldLabel="挂牌不含税单价" fieldProp="listedPrice" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="挂牌含税单价" fieldProp="listedTaxPrice" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="对标价格" fieldProp="benchmarkPrice" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="单价模式" fieldProp="priceModel" xtype="combo" key="djms" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="配送方式" fieldProp="distributionWay" xtype="combo" key="psfs" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="运输方式" fieldProp="transportWay" xtype="combo" key="ysfs" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="支付方式" fieldProp="payWay" xtype="combo" key="zhlx" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="有效开始时间" fieldProp="effectiveStartTime" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="有效结束时间" fieldProp="effectiveEndTime" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="币种" fieldProp="currency" xtype="combo" key="currency" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="贸易类型" fieldProp="tradeType" xtype="combo" key="tradeType" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="单价单位" fieldProp="unit" xtype="combo" key="priceUnit" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="重量单位" fieldProp="unitWeight" xtype="combo" key="unit" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="区域编码" fieldProp="areaNo" xtype="textfield" hidden="true" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="区域名称" fieldProp="areaName" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="提货地编码" fieldProp="deliveryPlaceNo" xtype="textfield" hidden="true" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="提货地名称" fieldProp="deliveryPlaceName" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="提货地分类编码" fieldProp="deliveryPlaceClassNo" xtype="textfield" hidden="true" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="提货地分类名称" fieldProp="deliveryPlaceClassName" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="产品分类编码" fieldProp="productClassNo" xtype="textfield" hidden="true" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="产品分类名称" fieldProp="productClassName" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="牌号编码" fieldProp="skuNo" xtype="textfield" hidden="true" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="牌号名称" fieldProp="skuName" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="产品编码" fieldProp="materielNo" xtype="textfield" hidden="true" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="产品名称" fieldProp="materielName" xtype="textfield" readOnly="true" allowBlank="true" />
			<formwidget fieldLabel="备注" fieldProp="remark" xtype="textfield" hidden="true" allowBlank="true" />
			<formwidget xtype="filesetEnd" />
			<formwidget xtype="filesetBegin" title="制单用户信息" columns="4"/>
			<formwidget fieldLabel="制单人" fieldProp="createByName" xtype="displayfield" />
			<formwidget fieldLabel="制单时间" fieldProp="gmtCreate" xtype="displayfield" />
			<formwidget fieldLabel="单位名称" fieldProp="orgName" xtype="displayfield" />
			<formwidget fieldLabel="部门名称" fieldProp="deptName" xtype="displayfield" />
			<formwidget fieldLabel="最后修改人" fieldProp="updateByName" xtype="displayfield" />
			<formwidget fieldLabel="最后修改时间" fieldProp="gmtModified" xtype="displayfield" />
			<formwidget xtype="filesetEnd" />
		</formpanel>
		<button id="save" text="保存" iconCls="saveButton" handler="CrrHandler" />
	</window>
	<script id="script"><![CDATA[
		// 触发事件
		function CrrHandler(t) {
			// 保存&更新事件
			if (t.id == "save") {
				var formpanel = Ext.getCmp("listedForm").getForm();
				if (formpanel.isValidCux()) {
					var data = formpanel.getValues();
					url = "/webapi/marketing/listed/edit";
					post(url, data, function(res) {
						Ext.MessageBox.alert("提示", res.msg);
						Ext.getCmp('listedListNew').getStore().load();
						Ext.getCmp('listedFormWin').close();
					});
				}
			}
		}
	]]></script>
</page>
<?xml version="1.0" encoding="UTF-8"?>
<page id="chooseMateriel" version="1.0">
	<window id="materielWin" title="选择产品档案" autoScroll="true" width="1000" height="600" resize="false" maximizable="true">
		<gridpanel id="materiel" url="/webapi/archives/materiel/page/list" mode="single">
			<column label="产品编码" prop="materielNo" xtype="textfield" />
			<column label="产品名称" prop="materielName" xtype="textfield" />
			<column label="牌号编码" prop="skuNo" xtype="textfield" />
			<column label="牌号名称" prop="skuName" xtype="textfield" />
			<column label="产品分类编码" prop="productClassNo" xtype="textfield" />
			<column label="产品分类名称" prop="productClassName" xtype="textfield" />
		</gridpanel>
		<button id="materielVerify" text="确定" iconCls="commitButton" handler="CrrHandler" callback="confirm" />
	</window>
	<script id="script"><![CDATA[
		// 触发事件
		function CrrHandler(t) {
			// 确定事件
			if (t.id == "materielVerify") {
				var records = Ext.getCmp("materiel").getSelectionModel().getSelection();
				if (records.length != 1) {
					Ext.MessageBox.alert("提示", "请选择一行进行确认!");
					return false;
				}
				eval(t.callback + "(records[0].data)");
				materielWin.close();
			}
		}
	]]></script>
</page>